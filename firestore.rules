rules_version = '2';
// ACM Docs: who may read and write what in Firestore.
// Paste into Firebase console › Firestore Database › Rules › Publish.
//
// Only public things live here: @name, display name and the account's PUBLIC key (the "open padlock").
// No emails, no phone numbers, nothing secret. And no lists: you can look up ONE exact @name,
// never download all users.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function validHandle(h) {
      return h is string && h.matches('^[a-z0-9_]{3,20}$')
        && !(h in ['admin', 'administrator', 'acm', 'acmdocs', 'acm_docs', 'acmcode', 'acm_code', 'support', 'suport', 'help', 'ajutor', 'root', 'system', 'official', 'oficial', 'security', 'securitate']);
    }
    function validProfile(d, uid) {
      return d.keys().hasOnly(['name', 'handle', 'key', 'fp', 'created'])
        && d.keys().hasAll(['name', 'handle', 'key', 'fp'])
        && d.name is string && d.name.size() <= 60
        && validHandle(d.handle)
        && d.key is string && d.key.size() < 8000
        && d.fp is string && d.fp.size() == 64
        // the @name in the profile must be reserved for this same account (in the same write)
        && getAfter(/databases/$(database)/documents/usernames/$(d.handle)).data.uid == uid;
    }

    // users/{uid}: public profile + padlock, so others can lock documents for this account
    match /users/{uid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data, uid);
      // changing @name: the old one must be released in the same write (one name per account)
      allow update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data, uid)
        && (resource.data.get('handle', '') == ''
            || resource.data.handle == request.resource.data.handle
            || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.handle)));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // usernames/{handle} → { uid }: who owns each @name (unique, first come first served)
    match /usernames/{handle} {
      allow get: if signedIn();
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;
      // released only by its owner, when the profile no longer uses it (rename or account deleted)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle != handle);
    }

    // everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
