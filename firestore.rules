rules_version = '2';
// ACM Docs: who may read and write what in Firestore. Published from GitHub (workflow "Server").
//
// Only public things live here: @name, display name and the account's PUBLIC key.
// No emails, no phone numbers, nothing secret. And no lists: you can look up ONE exact @name,
// never download all users.
service cloud.firestore {
  match /databases/{database}/documents {

    function deviceDoc(uid, dev) { return get(/databases/$(database)/documents/accounts/$(uid)/devices/$(dev)); }
    function devId() { return request.auth.token.get('dev', null); }
    // a device session must be renewed by its device key at least once a day
    function freshSession() { return request.auth.token.auth_time * 1000 > request.time.toMillis() - 26 * 3600 * 1000; }
    /** this exact device session is active (not blocked, not removed) and recent */
    function activeDeviceOf(uid) {
      return request.auth != null && request.auth.uid == uid && devId() is string
        && freshSession() && deviceDoc(uid, devId()).data.status == 'active';
    }
    // signed in with a confirmed email; a device session of a blocked device gets nothing
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true
        && (devId() == null || deviceDoc(request.auth.uid, devId()).data.status == 'active');
    }
    // the plan's encrypted cloud space: growth only while used + growth stays within the limit
    function underLimit(uid, grow) {
      let c = get(/databases/$(database)/documents/accounts/$(uid)/meta/cloud).data;
      return grow <= 0 || c.used + grow <= c.limit;
    }
    function validHandle(h) {
      return h is string && h.matches('^[a-z0-9_]{3,20}$')
        && !(h in ['admin', 'administrator', 'acm', 'acmdocs', 'acm_docs', 'acmcode', 'acm_code', 'support', 'suport', 'help', 'ajutor', 'root', 'system', 'official', 'oficial', 'security', 'securitate']);
    }
    function validProfile(d, uid) {
      return d.keys().hasOnly(['name', 'handle', 'key', 'fp', 'created'])
        && d.keys().hasAll(['name', 'handle', 'key', 'fp'])
        // a display name, never markup or control characters
        && d.name is string && d.name.size() <= 60 && !d.name.matches('.*[<>&"`\\\\{}].*')
        && validHandle(d.handle)
        // ACMK v1 public key bundle: 3205 bytes = 4276 base64 characters
        && d.key is string && d.key.size() == 4276 && d.key.matches('^[A-Za-z0-9+/]+=*$')
        && d.fp is string && d.fp.matches('^[0-9a-f]{64}$')
        // the @name in the profile must be reserved for this same account (in the same write)
        && getAfter(/databases/$(database)/documents/usernames/$(d.handle)).data.uid == uid;
    }

    // users/{uid}: public profile + public key, so others can lock documents for this account
    match /users/{uid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data, uid);
      // the public key never changes once published: a stolen password cannot swap it.
      // Changing @name: the old one must be released in the same write (one name per account)
      // Changes (display name, @name) come only from a device of the account: the password alone
      // cannot rename someone or free their @name for an impostor. The one exception: an old
      // profile that never had an @name picks its first one.
      allow update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data, uid)
        && (activeDeviceOf(uid) || resource.data.get('handle', '') == '')
        && request.resource.data.key == resource.data.key
        && request.resource.data.fp == resource.data.fp
        && (resource.data.get('handle', '') == ''
            || resource.data.handle == request.resource.data.handle
            || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.handle)));
      // deleting the profile goes through the server (account deletion, signed with the account keys)
      allow delete: if false;
    }

    // usernames/{handle} → { uid }: who owns each @name (unique, first come first served)
    match /usernames/{handle} {
      allow get: if signedIn();
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;
      // released only by its owner, when the profile no longer uses it (rename)
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle != handle;
    }

    // accounts/{uid}: devices, sign-in events and the encrypted cloud data of an account.
    // Only a device of that account, signed in with its own recent device session and not blocked,
    // gets in. Everything readable here is either encrypted on the devices or just ids and dates.
    match /accounts/{uid} {
      match /devices/{d} {
        allow read: if activeDeviceOf(uid);
        // a device only fills in its own (encrypted) description
        allow update: if activeDeviceOf(uid) && d == devId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['info'])
          && request.resource.data.info is string && request.resource.data.info.size() < 4000;
      }
      match /events/{e} {
        allow read: if activeDeviceOf(uid);
      }
      // contact requests sent to this account (written only by the server function): the owner's
      // devices read them and mark them added / ignored
      match /requests/{from} {
        allow read, delete: if activeDeviceOf(uid);
        allow update: if activeDeviceOf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['done', 'ignored'];
      }
      // encrypted records: { b: base64 ciphertext, v: version, at: time }, at most ~500 KB each,
      // and only while the account's encrypted cloud is under its plan's limit
      match /vault/{rest=**} {
        allow read, delete: if activeDeviceOf(uid);
        allow create, update: if activeDeviceOf(uid) && syncOn()
          && request.resource.data.keys().hasOnly(['b', 'v', 'at'])
          && request.resource.data.b is string && request.resource.data.b.size() <= 700000
          && underLimit(uid, request.resource.data.b.size() - (resource == null ? 0 : resource.data.get('b', '').size()));
      }
      // the plan in effect and the cloud counter (written only by the server functions)
      match /meta/{m} {
        allow read: if activeDeviceOf(uid);
      }
      // this month's counters (server only; the per-document marks stay private)
      match /usage/{month} {
        allow read: if activeDeviceOf(uid);
      }
      // invitations into a Family / Business group (answered through the server)
      match /invites/{g} {
        allow read: if activeDeviceOf(uid);
      }
    }
    // encrypted chat: only the members of a conversation read it, and only from an active device of
    // theirs. Messages are .acm envelopes sealed on the sender's device; the server cannot read them.
    function chatOn() {
      let p = /databases/$(database)/documents/server/switches;
      return !exists(p) || (get(p).data.get('all', false) != true && get(p).data.get('off', {}).get('chat', false) != true);
    }
    function chatDoc(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data; }
    match /chats/{cid} {
      allow read: if request.auth != null && activeDeviceOf(request.auth.uid) && request.auth.uid in resource.data.members;
      // a member only marks the latest activity (for the conversation list)
      allow update: if request.auth != null && activeDeviceOf(request.auth.uid) && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastFrom'])
        && request.resource.data.lastAt == request.time && request.resource.data.lastFrom == request.auth.uid;
      match /msgs/{mid} {
        allow read: if request.auth != null && activeDeviceOf(request.auth.uid) && request.auth.uid in chatDoc(cid).members;
        allow create: if request.auth != null && activeDeviceOf(request.auth.uid) && chatOn()
          && request.auth.uid in chatDoc(cid).members
          && chatDoc(cid).get('blocked', []).size() == 0
          && request.resource.data.keys().hasOnly(['from', 'at', 'kind', 'box', 'fid'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.kind in ['text', 'file']
          && request.resource.data.box is string && request.resource.data.box.size() <= 600000
          && (request.resource.data.kind == 'text'
              ? !('fid' in request.resource.data)
              : request.resource.data.fid is string && request.resource.data.fid.matches('^[0-9a-f]{32}$'));
        // a sender may delete its own message (for everyone)
        allow delete: if request.auth != null && activeDeviceOf(request.auth.uid) && resource.data.from == request.auth.uid;
      }
    }

    // what is paused right now (kill switches from the control panel) and the message about it:
    // public, so the app can say so even before signing in. Written only by the server.
    match /server/switches {
      allow get: if true;
    }
    function syncOn() {
      let p = /databases/$(database)/documents/server/switches;
      return !exists(p) || (get(p).data.get('all', false) != true && get(p).data.get('off', {}).get('sync', false) != true);
    }

    // pairings, rate limits, billing, groups, server keys and secrets, sign-in addresses, reports,
    // promotions, the control panel's log: only the server functions touch them

    // everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
