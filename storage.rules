rules_version = '2';
// ACM Docs: encrypted blocks of the cloud sync. Each account can reach only its own folder, and only
// from an active, recent device session. The blocks are encrypted on the device: the server and
// ACM Docs see only random names and unreadable bytes.
service firebase.storage {
  match /b/{bucket}/o {
    function devId() { return request.auth.token.get('dev', null); }
    function freshSession() { return request.auth.token.auth_time * 1000 > request.time.toMillis() - 26 * 3600 * 1000; }
    function activeDevice(uid) {
      return request.auth != null && request.auth.uid == uid && devId() is string && freshSession()
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/accounts/$(uid)/devices/$(devId())).data.status == 'active';
    }
    match /accounts/{uid}/blobs/{id} {
      allow get, delete: if id.matches('^[0-9a-f]{32}$') && activeDevice(uid);
      // new blocks only (a block is never rewritten), up to 110 MB
      allow create: if id.matches('^[0-9a-f]{32}$') && activeDevice(uid)
        && resource == null
        && request.resource.size <= 110 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        // within the plan's encrypted cloud space (counted by the server)
        && firestore.get(/databases/(default)/documents/accounts/$(uid)/meta/cloud).data.used + request.resource.size
           <= firestore.get(/databases/(default)/documents/accounts/$(uid)/meta/cloud).data.limit;
      allow list, update: if false;
    }
    // documents sent in a chat: sealed on the sender's device for the chat's members (.acm)
    function chatMember(cid) {
      return request.auth != null && devId() is string && freshSession() && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/accounts/$(request.auth.uid)/devices/$(devId())).data.status == 'active'
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(cid)).data.members;
    }
    match /chats/{cid}/files/{fid} {
      allow get: if fid.matches('^[0-9a-f]{32}$') && chatMember(cid);
      allow create: if fid.matches('^[0-9a-f]{32}$') && chatMember(cid) && resource == null
        && request.resource.size <= 110 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.uploader == request.auth.uid;
      allow list, update, delete: if false;
    }
    match /{all=**} { allow read, write: if false; }
  }
}
