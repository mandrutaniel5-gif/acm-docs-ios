<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of ACM Docs goes into cloud backups or phone-to-phone transfers: invoices, clients and
     settings stay on the phone (and in the encrypted cloud sync, if the person turns it on). -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
