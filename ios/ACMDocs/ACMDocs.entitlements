<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the account keys live in this app's own Keychain group (never shared, never synced) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ro.acmcode.docs</string>
	</array>
</dict>
</plist>
